# Variables d'environnement du service Mémoire.
#
# Pour le développement local, copiez ce fichier en « .env » : ses valeurs sont
# celles de la base de dev/compose.yaml et ne protègent rien. Node les charge
# avec l'option --env-file, par exemple :
#
#   node --env-file=.env apps/jobs/dist/cli.js db-bootstrap
#   node --env-file=.env apps/jobs/dist/cli.js migrate
#   node --env-file=.env apps/server/dist/main.js
#
# Sur une instance, le déploiement écrit ces variables dans /etc/memoire/app.env
# avec les valeurs de l'environnement.

# Environnement : preview, production, development ou test.
APP_ENV=development

# Convention de l'écosystème Node.js. L'image la fixe à production.
NODE_ENV=development

# Version annoncée par /health et inscrite dans chaque ligne de journal. L'image
# la reçoit à sa construction (identifiant du commit) : app.env ne la définit
# pas.
APP_VERSION=dev

# Port d'écoute du service HTTP. 8080 par défaut.
PORT=8080

# Nom public du service et adresse de contact du compte ACME. Seul Caddy les
# lit, sur l'instance.
PUBLIC_HOSTNAME=memoire.example.com
ACME_EMAIL=admin@example.com

# Base PostgreSQL.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=memoire

# verify-full sur OVHcloud : la connexion est chiffrée et le certificat du
# serveur est vérifié contre l'autorité que désigne PGSSLROOTCERT, soit
# /etc/memoire/db-ca.pem sur une instance. disable pour la base locale et la
# CI. Aucun autre mode n'est accepté.
PGSSLMODE=disable

# Mots de passe des cinq rôles SQL. Chaque processus ne lit que ceux des rôles
# dont il se sert.
DB_APP_PASSWORD=app-local
DB_AUTH_PASSWORD=auth-local
DB_QUEUE_PASSWORD=queue-local
DB_BACKUP_PASSWORD=backup-local
DB_MIGRATOR_PASSWORD=migrator-local

# Compte d'administration de la base, que seul le job db-bootstrap utilise. Sur
# OVHcloud, son mot de passe n'est jamais enregistré sur l'instance : le
# workflow « Amorcer la base » le transmet le temps du job.
DB_ADMIN_USER=avnadmin
DB_ADMIN_PASSWORD=avnadmin
