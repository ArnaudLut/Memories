package_update: true
package_upgrade: true
packages:
  - docker-ce
  - docker-ce-cli
  - containerd.io
  - docker-compose-plugin
  - ufw
  - unattended-upgrades

users:
  # Compte du canal de déploiement. Sa seule clé impose la commande forcée et
  # interdit terminal et redirections ; sudo ne lui accorde que cette commande,
  # sans argument. Le shell ne sert qu'à sshd, pour lancer la commande.
  - name: deploy
    shell: /bin/sh
    lock_passwd: true
    sudo: 'ALL=(root) NOPASSWD: /usr/local/sbin/memoire-deploy ""'
    ssh_authorized_keys:
      - ${jsonencode("restrict,command=\"sudo /usr/local/sbin/memoire-deploy\" ${trimspace(deploy_public_key)}")}
%{ if length(admin_public_keys) > 0 ~}
  # Compte d'administration, créé seulement quand des clés sont fournies. Il ne
  # s'appelle pas admin : les images cloud d'Ubuntu ont déjà un groupe système
  # de ce nom, et useradd refuserait de créer le compte.
  - name: ops
    shell: /bin/bash
    lock_passwd: true
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys: ${jsonencode([for key in admin_public_keys : trimspace(key)])}
%{ endif ~}

# Clé d'hôte SSH fournie par OpenTofu, pour que la CI l'épingle dès la première
# connexion. Aucune autre clé d'hôte n'est créée.
ssh_deletekeys: true
ssh_keys:
  ed25519_private: ${jsonencode(host_private_key)}
  ed25519_public: ${jsonencode(trimspace(host_public_key))}

write_files:
  # Configuration lue par la commande forcée. Le dépôt d'images y est figé : une
  # clé de déploiement volée ne peut lancer que les images de ce dépôt.
  - path: /etc/memoire/deploy.conf
    content: |
      APP_ENV=${app_env}
      IMAGE_REPOSITORY=${image_repository}
      REGISTRY_HOST=${split("/", image_repository)[0]}

  # La commande forcée, copie exacte de deploy/host/memoire-deploy.
  - path: /usr/local/sbin/memoire-deploy
    permissions: "0755"
    encoding: b64
    content: ${deploy_stub_b64}

  # sshd : clés uniquement, pas de connexion de root, deux comptes admis.
  - path: /etc/ssh/sshd_config.d/00-memoire.conf
    content: |
      PermitRootLogin no
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      AuthenticationMethods publickey
      AllowUsers deploy ops

  # Journaux des conteneurs : 50 Mo au plus par conteneur.
  - path: /etc/docker/daemon.json
    content: |
      {
        "log-driver": "local",
        "log-opts": { "max-size": "10m", "max-file": "5" }
      }

  # Les conteneurs n'ont pas à lire les métadonnées de l'instance : elles
  # contiennent ce fichier, donc la clé d'hôte. Docker consulte la chaîne
  # DOCKER-USER avant ses propres règles et la garde telle qu'il la trouve. La
  # règle y est donc posée avant chaque lancement du service : elle est en
  # place quand le premier conteneur démarre, y compris après un redémarrage
  # de l'instance. Elle ne couvre pas un conteneur lancé sur le réseau de
  # l'hôte.
  - path: /etc/systemd/system/docker.service.d/10-metadata.conf
    content: |
      [Service]
      ExecStartPre=/bin/sh -c 'iptables -N DOCKER-USER 2>/dev/null; iptables -C DOCKER-USER -d 169.254.169.254 -j REJECT 2>/dev/null || iptables -I DOCKER-USER -d 169.254.169.254 -j REJECT'

  # Correctifs de sécurité chaque nuit vers 2 h UTC, pour Ubuntu comme pour le
  # dépôt de Docker, puis redémarrage à 3 h 30 UTC quand un correctif l'exige.
  - path: /etc/apt/apt.conf.d/52memoire-unattended-upgrades
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";
      Unattended-Upgrade::Origins-Pattern { "origin=Docker,label=Docker CE"; };
      Unattended-Upgrade::Automatic-Reboot "true";
      Unattended-Upgrade::Automatic-Reboot-Time "03:30";
  - path: /etc/systemd/system/apt-daily-upgrade.timer.d/10-memoire.conf
    content: |
      [Timer]
      OnCalendar=
      OnCalendar=*-*-* 02:00
      RandomizedDelaySec=30m

runcmd:
  - |
    set -eu
    systemctl daemon-reload
    systemctl restart apt-daily-upgrade.timer
    # Pare-feu de l'hôte : seuls SSH, HTTP et HTTPS entrent (UDP 443 pour
    # HTTP/3). Les ports publiés par Docker ne passent pas par ufw : les
    # règles 80 et 443 disent l'intention et couvrent un service hors Docker.
    ufw allow 22/tcp
    ufw allow 80/tcp
    ufw allow 443/tcp
    ufw allow 443/udp
    ufw --force enable
    # L'initialisation n'est déclarée finie que si le démon Docker répond, si
    # Compose est installé et si la règle des métadonnées est en place. La
    # commande forcée attend ce témoin.
    docker version
    docker compose version
    iptables -C DOCKER-USER -d 169.254.169.254 -j REJECT
    touch /etc/memoire/provisioned
