#cloud-config
#
# Initialisation de l'instance de Mémoire, rendue par OpenTofu (templatefile).
#
# Ce fichier part dans user_data : en changer un seul octet, même dans un
# commentaire, fait réinstaller l'instance. Il ne contient donc que ce qui ne
# bouge pas. Tout ce qui évolue avec l'application vit dans deploy/release/ et
# voyage dans l'image. Aucun secret de l'application ne passe par ici.

# Docker Engine et le greffon Compose viennent du dépôt apt de Docker, et non
# des paquets docker.io d'Ubuntu : ceux-ci sont dans « universe », dont
# Canonical ne garantit les correctifs de sécurité qu'aux abonnés Ubuntu Pro.
# Les versions ne sont pas figées, à dessein : chaque nuit, unattended-upgrades
# applique les correctifs de ce dépôt comme ceux d'Ubuntu (voir plus bas).
apt:
  sources:
    docker:
      source: "deb [signed-by=$KEY_FILE] https://download.docker.com/linux/ubuntu $RELEASE stable"
      # Clé de signature du dépôt, d'empreinte
      # 9DC8 5822 9FC7 DD38 854A E2D8 8D81 803C 0EBF CD88.
